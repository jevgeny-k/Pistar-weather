[Unit]
Description=Private prerecorded cat feeding reminder
Requires=pistar-weather-relay.service
After=pistar-weather-relay.service mmdvmhost.service pistar-modem-maintenance.service pistar-weather-autonomous.service

[Service]
Type=oneshot
User=pi-star
Group=pi-star
ExecStart=/opt/pistar-weather/venv/bin/python /opt/pistar-weather/reminders-v1/reminder.py
TimeoutStartSec=20min
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/pistar-weather
UMask=0077
