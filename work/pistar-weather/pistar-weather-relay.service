[Unit]
Description=Pi-Star local private voice relay
Wants=network-online.target
After=network-online.target
Before=mmdvmhost.service

[Service]
Type=simple
User=pi-star
Group=pi-star
Environment=PISTAR_SITE_CONFIG=/etc/pistar-weather/site.json
ExecStart=/usr/bin/python3 /opt/pistar-weather/proxy.py
WorkingDirectory=/opt/pistar-weather
RuntimeDirectory=pistar-weather
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/run/pistar-weather

[Install]
WantedBy=multi-user.target
